# Copy to .env and fill in. Loaded automatically by main.py via python-dotenv.

# Required for data_pipeline/download_stack.py (fetches blob content from Software
# Heritage's S3 bucket).
AWS_REGION=
AWS_KEY=
AWS_SECRET=

# Required to stream bigcode/the-stack-v2 from the HuggingFace Hub.
HF_TOKEN=

# Optional: omit (or set WANDB_MODE=disabled) to run training without a WANDB account.
WANDB_API_KEY=
